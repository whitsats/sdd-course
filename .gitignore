# ── 文档站点的构建产物（由 tools/build_site.py 与 zensical 生成）──
# 仓库里始终只有一份原文；site-src/ 是拼出来的，不要提交，否则会出现两套文档
site-src/
site-out/
.cache/

# ── Agent 工具的本地状态 ──────────────────────────────────────
.freebuff/

# ── 密钥：绝不入库 ───────────────────────────────────────────
# scripts/agnes-review.py 只从环境变量读 AGNES_API_KEY，不写文件；
# 这条兜底是为了防止以后有人图省事把 key 落到 .env 里。
.env
.env.local
*.env
!*.env.example

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Node（examples/rulesmith 用 node --test 跑，不装依赖）──────
node_modules/

# ── SQLite 本地库文件（examples/stockflow）──────────────────────
# var/ 是跑演示时生成的库文件（含 -wal / -shm）。
# 与 target/ 同类：仓里只保留 schema，库由命令生成。
examples/stockflow/var/

# ── Java / Maven（examples/billflow 用 mvn verify 跑门禁）─────
# target/ 是构建产物：class 文件、测试报告、jar。
# 它和 site-src/ 是同一类东西 —— 仓库里只保留源，产物由构建生成。
target/

# ── 编辑器 / 系统 ────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
